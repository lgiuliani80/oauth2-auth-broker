{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AuthBroker": {
    "Cache": {
      "RedisConnectionString": ""
    },
    "AllowedIssuers": [
      {
        "Issuer": "https://login.microsoftonline.com/00000000-0000-0000-0000-000000000000/v2.0",
        "MetadataAddress": "",
        "HandlingMode": "Exchange"
      },
      {
        "Issuer": "https://adfs.contoso.local/adfs",
        "MetadataAddress": "https://adfs.contoso.local/adfs/.well-known/openid-configuration",
        "HandlingMode": "PassThrough"
      }
    ],
    "ReissueRules": [
      {
        "Issuer": "https://login.microsoftonline.com/00000000-0000-0000-0000-000000000000/v2.0",
        "Audience": "api://source-api",
        "ClientIdSelector": "*",
        "Authority": "https://login.microsoftonline.com/11111111-1111-1111-1111-111111111111/v2.0",
        "ClientId": "22222222-2222-2222-2222-222222222222",
        "ClientSecret": "",
        "ClientCertificate": "",
        "ClientCertificatePassword": "",
        "Scope": "api://target-api/.default"
      }
    ]
  },
  "ReverseProxy": {
    "Routes": {
      "public": {
        "ClusterId": "backend",
        "Match": {
          "Path": "/public/{**catch-all}"
        }
      },
      "private": {
        "ClusterId": "backend",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/private/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "backend": {
        "Destinations": {
          "d1": {
            "Address": "https://httpbin.org/"
          }
        }
      }
    }
  }
}
